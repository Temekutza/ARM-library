<Window x:Class="ARM_library.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="240" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold" Text="Новый сотрудник" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="ФИО:"/>
        <TextBox x:Name="FullNameBox" Grid.Row="1" Grid.Column="1" Height="26"/>

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,0,0" Text="Должность:"/>
        <TextBox x:Name="PositionBox" Grid.Row="2" Grid.Column="1" Height="26" Margin="0,10,0,0"/>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Grid.ColumnSpan="2" Foreground="Firebrick" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Width="90" Margin="0,0,8,0" Content="Добавить" Click="Ok_Click"/>
            <Button Width="90" Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
